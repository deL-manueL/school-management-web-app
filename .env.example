# Local database settings
APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=school_system

# Production frontend origin. Use the exact Vercel URL in Railway.
# Example: FRONTEND_ORIGIN=https://ipmc-site.vercel.app
FRONTEND_ORIGIN=http://127.0.0.1:8000,http://localhost:8000

# Session settings
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_DOMAIN=
SESSION_SAVE_PATH=storage/sessions

# Local-only setup/debug scripts. Never enable this in production.
ALLOW_SETUP_SCRIPTS=false

# Local-only admin bootstrap values. Do not commit real production values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-use
